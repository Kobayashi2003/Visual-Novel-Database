# Route definitions for this app — the single source of truth, imported by every
# edge that fronts it: ./Caddyfile (standalone), deploy/Caddyfile (Docker), and
# AppGateway (several apps sharing one public port).
#
# Upstreams come from env so the same routes serve loopback ports and container
# names alike. Defaults are the standalone ports — 127.0.0.1, not localhost: on
# Windows localhost resolves to ::1 first and each cold connection to an
# IPv4-only listener would eat a ~20s IPv6 timeout.
#   *_UPSTREAM             host:port of each backend
#   IMGSERVE_IMAGE_FOLDER  imgserve's cache root, served straight off disk on hits
#
# Auth lives here, not in the backends. Each backend prefix exposes an explicit
# allowlist of the routes the frontend uses (everything else 403s without being
# forwarded) and gates them with forward_auth against userserve /auth/verify.
# vndb / imgserve / transserve / musicserve therefore hold no auth code at all,
# and their admin and write routes remain reachable on the loopback ports.
# userserve is exempt: every one of its routes already guards itself.
#
# Rules for anything added here:
#   - No matcher-less `handle` at top level. Under AppGateway the catch-all is the
#     landing page. (One nested inside a handle_path is fine — it is scoped to it,
#     like the imgserve cache-miss fallback below.)
#   - Prefix named matchers with the app (@vndb_*). Under AppGateway every app's
#     snippet is imported into one site block, and matcher names are scoped to it.
#   - Backend prefixes stay top-level, not under the frontend's basePath:
#     lib/constants.ts sends them absolute, and basePath does not rewrite fetch()
#     URLs. That is also why the frontend is /visual-novel-database, not /vndb —
#     /vndb is the Flask API's.
#
# handle_path strips the prefix, so each Flask app sees its own route shape
# (/img/..., /login, /v123).

handle_path /imgserve/* {
	route {
		# Only the read surface the frontend uses is public. imgserve's write
		# routes and /tasks/* keep working on the loopback port — they are simply
		# not part of what this edge exposes, so imgserve needs no auth code.
		@vndb_img_public {
			method GET HEAD
			path /img/* /bg
		}
		handle @vndb_img_public {
			# `route` above, and this gate first inside it, because Caddy reorders
			# bare directives by default priority — the file_server fast path
			# below would otherwise serve cached images without ever asking.
			forward_auth {$USERSERVE_UPSTREAM:127.0.0.1:5002} {
				uri /auth/verify
			}

			# Cache hit: serve off disk, Flask never runs. A miss fails the `file`
			# matcher and falls through to the proxy below, which fetches-and-stores.
			@vndb_cached_img {
				path_regexp imgpath ^/img(/.+\.jpg)$
				file {
					try_files {re.imgpath.1}
					root {$IMGSERVE_IMAGE_FOLDER}
				}
			}
			handle @vndb_cached_img {
				root * {$IMGSERVE_IMAGE_FOLDER}
				rewrite * {re.imgpath.1}
				# `private`: these sit behind a session now, so no shared proxy
				# may keep a copy.
				header Cache-Control "private, max-age=31536000, immutable"
				file_server
			}

			handle {
				reverse_proxy {$IMGSERVE_UPSTREAM:127.0.0.1:5001} {
					# Cold fetches pull from t.vndb.org and can take seconds.
					transport http {
						read_timeout 30s
						write_timeout 30s
					}
				}
			}
		}
		handle {
			respond 403
		}
	}
}

handle_path /userserve/* {
	reverse_proxy {$USERSERVE_UPSTREAM:127.0.0.1:5002}
}

handle_path /vndb/* {
	route {
		# The query routes only: /v, /v17, /v17/rg and the same for r c p s g i.
		# Keeps /admin, /tasks/*, /trash/* and the CRUD resource routes loopback-only.
		@vndb_api {
			method GET HEAD
			path_regexp ^/[vrcpsgi]\d*(/rg)?$
		}
		handle @vndb_api {
			forward_auth {$USERSERVE_UPSTREAM:127.0.0.1:5002} {
				uri /auth/verify
			}
			reverse_proxy {$VNDB_UPSTREAM:127.0.0.1:5000}
		}
		handle {
			respond 403
		}
	}
}

handle_path /transserve/* {
	route {
		# Lookups only — the term / passage write routes stay loopback-only.
		@vndb_trans_public {
			method POST
			path /term/lookup /passage/lookup
		}
		handle @vndb_trans_public {
			forward_auth {$USERSERVE_UPSTREAM:127.0.0.1:5002} {
				uri /auth/verify
			}
			reverse_proxy {$TRANSSERVE_UPSTREAM:127.0.0.1:5003}
		}
		handle {
			respond 403
		}
	}
}

handle_path /musicserve/* {
	route {
		@vndb_music_public {
			method GET HEAD
			path /music/* /cover/* /meta/*
		}
		@vndb_music_available {
			method POST
			path /available
		}
		handle @vndb_music_public {
			forward_auth {$USERSERVE_UPSTREAM:127.0.0.1:5002} {
				uri /auth/verify
			}
			reverse_proxy {$MUSICSERVE_UPSTREAM:127.0.0.1:5004}
		}
		handle @vndb_music_available {
			forward_auth {$USERSERVE_UPSTREAM:127.0.0.1:5002} {
				uri /auth/verify
			}
			reverse_proxy {$MUSICSERVE_UPSTREAM:127.0.0.1:5004}
		}
		handle {
			respond 403
		}
	}
}

# The API specs and their browser, straight off disk. Gated like everything else:
# the specs describe loopback-only admin and write routes, so they are not public.
# Being behind the gate is also what makes the browser's "try it" work — the
# session cookie rides along, so a request from the page is a real, authenticated
# request, and a route outside a prefix's allowlist answers 403 exactly as it
# would for the frontend.
handle_path /docs* {
	route {
		# forward_auth written out, so a rejected probe can answer two ways. A
		# browser navigation gets the login page — the access token lasts 30
		# minutes, so arriving here signed out is routine, and a raw 401 body is
		# something the visitor cannot act on. Anything else (the viewer's own
		# fetches for the specs) keeps the JSON error it knows how to report.
		@vndb_docs_page header Accept *text/html*
		reverse_proxy {$USERSERVE_UPSTREAM:127.0.0.1:5002} {
			method GET
			rewrite /auth/verify
			header_up X-Forwarded-Method {method}
			header_up X-Forwarded-Uri {uri}

			@vndb_docs_pass status 2xx
			handle_response @vndb_docs_pass {
				request_header X-User-Id {rp.header.X-User-Id}
			}
			@vndb_docs_deny status 401
			handle_response @vndb_docs_deny {
				redir @vndb_docs_page /visual-novel-database/login?next=/docs/ 302
				header Content-Type application/json
				respond `{"error":"unauthorized","message":"Not signed in."}` 401
			}
		}
		root * {$API_DOCS_FOLDER:./docs/api}
		try_files {path} /index.html
		file_server
	}
}

# Next.js, under the basePath baked in at build time — so `handle`, not
# handle_path: the prefix must survive. The bare prefix is matched too because
# Next has trailingSlash off and 308s /visual-novel-database/ to
# /visual-novel-database, which `/visual-novel-database/*` alone would miss.
@vndb_frontend path /visual-novel-database /visual-novel-database/*
handle @vndb_frontend {
	reverse_proxy {$NEXT_UPSTREAM:127.0.0.1:5010}
}
