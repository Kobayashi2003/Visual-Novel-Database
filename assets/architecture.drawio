<mxfile host="vscode" agent="architecture" version="21.0.0">
  <diagram name="Architecture" id="vndb-arch">
    <mxGraphModel dx="1560" dy="1035" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="&lt;b style=&quot;font-size:26px&quot;&gt;Visual Novel Database — Architecture&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#4B5563&quot;&gt;One public port. Every backend call is gated at the edge, so the services themselves carry no auth code.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="60" y="24" width="1100" height="60" as="geometry" />
        </mxCell>

        <mxCell id="browser" value="&lt;b style=&quot;font-size:15px&quot;&gt;Browser&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;httpOnly JWT cookies ride along&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#1D4ED8;strokeWidth=2;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="110" width="250" height="62" as="geometry" />
        </mxCell>

        <mxCell id="caddy" value="&lt;b style=&quot;font-size:18px&quot;&gt;Caddy · :30709&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;The only public ingress. Routes by path prefix, and each backend prefix exposes an explicit allowlist of the routes the frontend actually uses.&lt;br&gt;Allowlisted requests are first probed with forward_auth against userserve /auth/verify (204 = pass, 401 = reject). Anything off the list is answered 403 and never forwarded —&lt;br&gt;so /vndb/admin, the write routes and /tasks/* stay reachable only on the loopback ports. imgserve cache hits are served straight off disk by Caddy; Flask never runs.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#B45309;strokeWidth=2.5;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="215" width="1440" height="130" as="geometry" />
        </mxCell>

        <mxCell id="next" value="&lt;b style=&quot;font-size:14px&quot;&gt;Next.js 16 · :5010&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;standalone build&lt;br&gt;&lt;br&gt;basePath /visual-novel-database&lt;br&gt;all pages are client components&lt;br&gt;proxy.ts redirects signed-out visitors to /login&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#1D4ED8;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="400" width="250" height="150" as="geometry" />
        </mxCell>

        <mxCell id="vndb" value="&lt;b style=&quot;font-size:14px&quot;&gt;vndb · :5000&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;core data + search&lt;br&gt;&lt;br&gt;Postgres vndb&lt;br&gt;Redis db0 (cache)&lt;br&gt;Celery · Redis db1/db2&lt;br&gt;crawls the Kana API&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0E7FF;strokeColor=#4338CA;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="335" y="400" width="215" height="150" as="geometry" />
        </mxCell>

        <mxCell id="imgserve" value="&lt;b style=&quot;font-size:14px&quot;&gt;imgserve · :5001&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;image cache&lt;br&gt;&lt;br&gt;Postgres imgserve&lt;br&gt;Redis db3 · db8&lt;br&gt;Celery · Redis db4/db5&lt;br&gt;fetches t.vndb.org → disk&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0E7FF;strokeColor=#4338CA;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="575" y="400" width="215" height="150" as="geometry" />
        </mxCell>

        <mxCell id="userserve" value="&lt;b style=&quot;font-size:14px&quot;&gt;userserve · :5002&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;identity &amp;amp; collections&lt;br&gt;&lt;br&gt;Postgres userserve&lt;br&gt;Redis db7 (codes, blocklist)&lt;br&gt;JWT cookies · CSRF · SMTP&lt;br&gt;&lt;b style=&quot;color:#BE185D&quot;&gt;answers /auth/verify&lt;/b&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE7F3;strokeColor=#BE185D;strokeWidth=2.5;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="815" y="400" width="215" height="150" as="geometry" />
        </mxCell>

        <mxCell id="transserve" value="&lt;b style=&quot;font-size:14px&quot;&gt;transserve · :5003&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;en→ja translation&lt;br&gt;&lt;br&gt;Postgres transserve&lt;br&gt;dictionary + passage&lt;br&gt;memory, keyed by hash&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0E7FF;strokeColor=#4338CA;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1055" y="400" width="195" height="150" as="geometry" />
        </mxCell>

        <mxCell id="musicserve" value="&lt;b style=&quot;font-size:14px&quot;&gt;musicserve · :5004&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;VN theme music&lt;br&gt;&lt;br&gt;music files on disk&lt;br&gt;stream · cover · meta&lt;br&gt;no database&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0E7FF;strokeColor=#4338CA;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1270" y="400" width="230" height="150" as="geometry" />
        </mxCell>

        <mxCell id="storesLabel" value="&lt;b&gt;Backing stores&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="60" y="580" width="200" height="30" as="geometry" />
        </mxCell>

        <mxCell id="postgres" value="&lt;b style=&quot;font-size:14px&quot;&gt;PostgreSQL · :5432&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;One database per service:&lt;br&gt;vndb · imgserve · userserve · transserve&lt;br&gt;Runs as a Windows service, not under the launcher.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#047857;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="615" width="460" height="105" as="geometry" />
        </mxCell>

        <mxCell id="redis" value="&lt;b style=&quot;font-size:14px&quot;&gt;Redis · :6379&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;db0 vndb cache · db1/db2 vndb Celery&lt;br&gt;db3 imgserve cache · db4/db5 imgserve Celery · db8 imgserve&lt;br&gt;db7 userserve — verification codes and the JWT blocklist&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#047857;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="545" y="615" width="460" height="105" as="geometry" />
        </mxCell>

        <mxCell id="disk" value="&lt;b style=&quot;font-size:14px&quot;&gt;Local disk&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Image cache — served directly by Caddy on a hit&lt;br&gt;Music library (musicserve)&lt;br&gt;Scheduled database backups&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#047857;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1030" y="615" width="470" height="105" as="geometry" />
        </mxCell>

        <mxCell id="extLabel" value="&lt;b&gt;External services&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="60" y="750" width="200" height="30" as="geometry" />
        </mxCell>

        <mxCell id="kana" value="&lt;b style=&quot;font-size:14px&quot;&gt;VNDB Kana API&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;api.vndb.org/kana&lt;br&gt;Crawled into Postgres on a schedule (vndb)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#6B7280;strokeWidth=2;dashed=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="785" width="460" height="90" as="geometry" />
        </mxCell>

        <mxCell id="tvndb" value="&lt;b style=&quot;font-size:14px&quot;&gt;t.vndb.org&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Cover art and screenshots&lt;br&gt;Mirrored to the local cache on first miss (imgserve)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#6B7280;strokeWidth=2;dashed=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="545" y="785" width="460" height="90" as="geometry" />
        </mxCell>

        <mxCell id="smtp" value="&lt;b style=&quot;font-size:14px&quot;&gt;SMTP · QQ / Gmail&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Verification codes and password-reset mail&lt;br&gt;Dispatched asynchronously (userserve)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#6B7280;strokeWidth=2;dashed=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1030" y="785" width="470" height="90" as="geometry" />
        </mxCell>

        <mxCell id="logserve" value="&lt;b style=&quot;font-size:14px&quot;&gt;logserve · :5005&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Developer tool — browse and replay recorded searches&lt;br&gt;Reads the vndb logs table. No Caddy route: loopback only.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#C2410C;strokeWidth=2;dashed=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="915" width="460" height="90" as="geometry" />
        </mxCell>

        <mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;&lt;b style=&quot;color:#BE185D&quot;&gt;●&lt;/b&gt; Gated prefix — forward_auth must return 204 first&lt;br&gt;&lt;b style=&quot;color:#BE185D&quot;&gt;▢&lt;/b&gt; userserve — the single authority on identity&lt;br&gt;Launcher: backend/launch.py (procserve) · start-prod.ps1 owns Caddy + Next.js&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D1D5DB;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="545" y="915" width="955" height="90" as="geometry" />
        </mxCell>

        <mxCell id="e0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6B7280;strokeWidth=2;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="browser" target="caddy">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e1" value="pages — not gated" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6B7280;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=10;" edge="1" parent="1" source="caddy" target="next">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="gated" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#BE185D;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#BE185D;" edge="1" parent="1" source="caddy" target="vndb">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="gated" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#BE185D;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#BE185D;" edge="1" parent="1" source="caddy" target="imgserve">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6B7280;strokeWidth=2;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="caddy" target="userserve">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="gated" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#BE185D;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#BE185D;" edge="1" parent="1" source="caddy" target="transserve">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="gated" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#BE185D;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#BE185D;" edge="1" parent="1" source="caddy" target="musicserve">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
