<mxfile host="vscode" agent="architecture" version="21.0.0">
  <diagram name="Architecture" id="vndb-arch">
    <mxGraphModel dx="1560" dy="1035" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="1420" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="&lt;b style=&quot;font-size:26px&quot;&gt;Visual Novel Database — Architecture&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#4B5563&quot;&gt;One public port. Every backend call is gated at the edge, so the services themselves carry no auth code.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="60" y="24" width="1200" height="60" as="geometry" />
        </mxCell>

        <!-- ===================== clients ===================== -->
        <mxCell id="browser" value="&lt;b style=&quot;font-size:15px&quot;&gt;Browser&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;httpOnly JWT cookies ride along&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#1D4ED8;strokeWidth=2;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="110" width="250" height="62" as="geometry" />
        </mxCell>

        <!-- ===================== edge ===================== -->
        <mxCell id="caddy" value="&lt;b style=&quot;font-size:18px&quot;&gt;Caddy · :30709&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;The only public ingress. Routes by path prefix, and each backend prefix exposes an explicit allowlist of the routes the frontend actually uses.&lt;br&gt;Allowlisted requests are first probed with forward_auth against userserve /auth/verify (204 = pass, 401 = reject). Anything off the list is answered 403 and never forwarded —&lt;br&gt;so /vndb/admin, the write routes and /tasks/* stay reachable only on the loopback ports. imgserve cache hits are served straight off disk by Caddy; Flask never runs.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#B45309;strokeWidth=2.5;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="210" width="1600" height="118" as="geometry" />
        </mxCell>

        <!-- ===================== web tier ===================== -->
        <mxCell id="webtier" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9CA3AF;strokeWidth=1.5;dashed=1;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="60" y="380" width="1600" height="250" as="geometry" />
        </mxCell>
        <mxCell id="webtierLabel" value="&lt;b style=&quot;font-size:13px;color:#374151&quot;&gt;WEB TIER&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;span style=&quot;font-size:11px;color:#6B7280&quot;&gt;— each Flask app is served by its own &lt;b&gt;Waitress&lt;/b&gt; thread pool (WAITRESS_THREADS, default 4; userserve 16). All bind loopback only.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="74" y="386" width="1000" height="22" as="geometry" />
        </mxCell>

        <mxCell id="next" value="&lt;b&gt;Next.js · :5010&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px&quot;&gt;standalone build&lt;br&gt;basePath /visual-novel-database&lt;br&gt;&lt;i&gt;node, not Waitress&lt;/i&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0E7FF;strokeColor=#4338CA;strokeWidth=2;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="80" y="424" width="200" height="90" as="geometry" />
        </mxCell>

        <mxCell id="vndb" value="&lt;b&gt;vndb · :5000&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px&quot;&gt;VNDB mirror, search,&lt;br&gt;crawl &amp;amp; edit&lt;br&gt;&lt;i&gt;Waitress + Celery + APScheduler&lt;/i&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#15803D;strokeWidth=2;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="310" y="424" width="200" height="90" as="geometry" />
        </mxCell>

        <mxCell id="imgserve" value="&lt;b&gt;imgserve · :5001&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px&quot;&gt;image mirror,&lt;br&gt;single-flight fetch&lt;br&gt;&lt;i&gt;Waitress + Celery + APScheduler&lt;/i&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#15803D;strokeWidth=2;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="540" y="424" width="200" height="90" as="geometry" />
        </mxCell>

        <mxCell id="userserve" value="&lt;b&gt;userserve · :5002&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px&quot;&gt;accounts, sessions,&lt;br&gt;collections &amp;amp; ratings&lt;br&gt;&lt;i&gt;Waitress + APScheduler&lt;/i&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE7F3;strokeColor=#BE185D;strokeWidth=2.5;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="770" y="424" width="200" height="90" as="geometry" />
        </mxCell>

        <mxCell id="transserve" value="&lt;b&gt;transserve · :5003&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px&quot;&gt;term base &amp;amp;&lt;br&gt;passage memory&lt;br&gt;&lt;i&gt;Waitress + APScheduler&lt;/i&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#15803D;strokeWidth=2;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1000" y="424" width="200" height="90" as="geometry" />
        </mxCell>

        <mxCell id="musicserve" value="&lt;b&gt;musicserve · :5004&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px&quot;&gt;audio library&lt;br&gt;&lt;i&gt;Waitress only&lt;/i&gt;&lt;br&gt;no database&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#15803D;strokeWidth=2;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1230" y="424" width="200" height="90" as="geometry" />
        </mxCell>

        <mxCell id="logserve" value="&lt;b&gt;logserve · :5005&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px&quot;&gt;dev log viewer&lt;br&gt;&lt;b style=&quot;color:#B91C1C&quot;&gt;no Caddy route&lt;/b&gt;&lt;br&gt;reads the vndb DB&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#6B7280;strokeWidth=1.5;dashed=1;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1460" y="424" width="180" height="90" as="geometry" />
        </mxCell>

        <mxCell id="schedNote" value="&lt;span style=&quot;font-size:11px;color:#6B7280&quot;&gt;&lt;b&gt;APScheduler&lt;/b&gt; runs &lt;i&gt;inside&lt;/i&gt; the Waitress process (backups, VNDB crawl jobs, access-log flush). Celery workers are started with &lt;code&gt;enable_scheduler=False&lt;/code&gt;, so a job never fires twice.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="80" y="536" width="1560" height="20" as="geometry" />
        </mxCell>
        <mxCell id="edgeNote" value="&lt;span style=&quot;font-size:11px;color:#6B7280&quot;&gt;Only vndb, imgserve, userserve, transserve and musicserve have a prefix at the edge. logserve does not, and is reachable on loopback only.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="80" y="580" width="1560" height="20" as="geometry" />
        </mxCell>

        <!-- ===================== worker tier ===================== -->
        <mxCell id="workertier" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9CA3AF;strokeWidth=1.5;dashed=1;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="60" y="680" width="740" height="180" as="geometry" />
        </mxCell>
        <mxCell id="workertierLabel" value="&lt;b style=&quot;font-size:13px;color:#374151&quot;&gt;WORKER TIER&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;span style=&quot;font-size:11px;color:#6B7280&quot;&gt;— separate processes; only vndb and imgserve have one&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="74" y="686" width="700" height="22" as="geometry" />
        </mxCell>

        <mxCell id="vndbCelery" value="&lt;b&gt;vndb Celery worker&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px&quot;&gt;pool=threads, concurrency = CPU count&lt;br&gt;crawl / refresh / bulk edit / relation graph&lt;br&gt;reached via &lt;code&gt;?sync=false&lt;/code&gt; → 202 + task_id&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#A16207;strokeWidth=2;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="80" y="724" width="330" height="106" as="geometry" />
        </mxCell>

        <mxCell id="imgCelery" value="&lt;b&gt;imgserve Celery worker&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px&quot;&gt;pool=threads, concurrency = CPU count&lt;br&gt;mirror / refetch / delete, sibling prefetch&lt;br&gt;(a cold page request enqueues the .t variant)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#A16207;strokeWidth=2;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="440" y="724" width="330" height="106" as="geometry" />
        </mxCell>

        <!-- ===================== stores ===================== -->
        <mxCell id="storetier" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9CA3AF;strokeWidth=1.5;dashed=1;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="60" y="910" width="1600" height="290" as="geometry" />
        </mxCell>
        <mxCell id="storesLabel" value="&lt;b style=&quot;font-size:13px;color:#374151&quot;&gt;STORES&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="74" y="916" width="300" height="22" as="geometry" />
        </mxCell>

        <mxCell id="postgres" value="&lt;b style=&quot;font-size:15px&quot;&gt;PostgreSQL · :5432&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Runs as a Windows service — the launcher never spawns it, it only waits for it.&lt;br&gt;One database per service, no cross-database queries:&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;&lt;b&gt;vndb&lt;/b&gt; — mirrored entities (JSONB relation columns + GIN), soft deletes, logs table&lt;br&gt;&lt;b&gt;imgserve&lt;/b&gt; — one row per mirrored image&lt;br&gt;&lt;b&gt;userserve&lt;/b&gt; — users, collections, ratings&lt;br&gt;&lt;b&gt;transserve&lt;/b&gt; — term base + passage memory&lt;br&gt;&lt;i&gt;logserve reads the vndb database; musicserve has none&lt;/i&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#1D4ED8;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="80" y="950" width="480" height="228" as="geometry" />
        </mxCell>

        <mxCell id="redis" value="&lt;b style=&quot;font-size:15px&quot;&gt;Redis · :6379&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;One server, one logical DB per concern — so no two consumers ever share a keyspace:&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;&lt;b&gt;0&lt;/b&gt; vndb response cache&amp;nbsp;&amp;nbsp;·&amp;nbsp;&amp;nbsp;&lt;b&gt;1&lt;/b&gt; vndb Celery broker&amp;nbsp;&amp;nbsp;·&amp;nbsp;&amp;nbsp;&lt;b&gt;2&lt;/b&gt; vndb Celery results&lt;br&gt;&lt;b&gt;3&lt;/b&gt; imgserve cache&amp;nbsp;&amp;nbsp;·&amp;nbsp;&amp;nbsp;&lt;b&gt;4&lt;/b&gt; imgserve Celery broker&amp;nbsp;&amp;nbsp;·&amp;nbsp;&amp;nbsp;&lt;b&gt;5&lt;/b&gt; imgserve Celery results&lt;br&gt;&lt;b&gt;6&lt;/b&gt; userserve rate limits&amp;nbsp;&amp;nbsp;·&amp;nbsp;&amp;nbsp;&lt;b&gt;7&lt;/b&gt; JWT blocklist + email codes&lt;br&gt;&lt;b&gt;8&lt;/b&gt; imgserve single-flight locks + access ZSET&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#B91C1C;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="590" y="950" width="530" height="228" as="geometry" />
        </mxCell>

        <mxCell id="disk" value="&lt;b style=&quot;font-size:15px&quot;&gt;Disk · DATA_FOLDER&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;&lt;b&gt;images/&lt;/b&gt; — the mirrored image cache. Laid out to match&lt;br&gt;t.vndb.org exactly, which is what lets Caddy answer a&lt;br&gt;cache hit with file_server, never touching Flask.&lt;br&gt;&lt;br&gt;&lt;b&gt;music/&lt;/b&gt; — audio library, scanned from disk&lt;br&gt;&lt;b&gt;backups/&lt;/b&gt; — scheduled pg_dump output&lt;br&gt;&lt;b&gt;fetch_state.json&lt;/b&gt; — per-type crawl cursor&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#7E22CE;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1150" y="950" width="490" height="228" as="geometry" />
        </mxCell>

        <!-- ===================== external ===================== -->
        <mxCell id="extLabel" value="&lt;b style=&quot;font-size:13px;color:#374151&quot;&gt;UPSTREAM&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="880" y="686" width="300" height="22" as="geometry" />
        </mxCell>

        <mxCell id="kana" value="&lt;b&gt;api.vndb.org/kana&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px&quot;&gt;entity data&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#6B7280;strokeWidth=1.5;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="880" y="724" width="230" height="48" as="geometry" />
        </mxCell>

        <mxCell id="tvndb" value="&lt;b&gt;t.vndb.org&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px&quot;&gt;cover / screenshot / portrait images&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#6B7280;strokeWidth=1.5;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1140" y="724" width="230" height="48" as="geometry" />
        </mxCell>

        <mxCell id="smtp" value="&lt;b&gt;SMTP (QQ / Gmail)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px&quot;&gt;verification &amp;amp; password-reset mail&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#6B7280;strokeWidth=1.5;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1400" y="724" width="240" height="48" as="geometry" />
        </mxCell>

        <!-- ===================== edges ===================== -->
        <mxCell id="e0" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#1D4ED8;strokeWidth=2.5;endArrow=block;" edge="1" parent="1" source="browser" target="caddy">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e0l" value="&lt;span style=&quot;font-size:11px;background:#fff&quot;&gt;https :30709&lt;/span&gt;" style="edgeLabel;html=1;align=center;" vertex="1" connectable="0" parent="e0">
          <mxGeometry x="-0.1" relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#B45309;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="caddy" target="next">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#B45309;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="caddy" target="vndb">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#B45309;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="caddy" target="imgserve">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#BE185D;strokeWidth=2.5;endArrow=block;" edge="1" parent="1" source="caddy" target="userserve">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4l" value="&lt;span style=&quot;font-size:11px;background:#fff;color:#BE185D&quot;&gt;&lt;b&gt;forward_auth&lt;/b&gt; /auth/verify&lt;/span&gt;" style="edgeLabel;html=1;align=center;" vertex="1" connectable="0" parent="e4">
          <mxGeometry x="0.2" relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#B45309;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="caddy" target="transserve">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#B45309;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="caddy" target="musicserve">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#A16207;strokeWidth=2;endArrow=block;dashed=1;" edge="1" parent="1" source="vndb" target="vndbCelery">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7l" value="&lt;span style=&quot;font-size:11px;background:#fff&quot;&gt;enqueue via Redis 1&lt;/span&gt;" style="edgeLabel;html=1;align=center;" vertex="1" connectable="0" parent="e7">
          <mxGeometry x="0.1" relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#A16207;strokeWidth=2;endArrow=block;dashed=1;" edge="1" parent="1" source="imgserve" target="imgCelery">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8l" value="&lt;span style=&quot;font-size:11px;background:#fff&quot;&gt;enqueue via Redis 4&lt;/span&gt;" style="edgeLabel;html=1;align=center;" vertex="1" connectable="0" parent="e8">
          <mxGeometry x="0.1" relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#6B7280;strokeWidth=1.5;endArrow=block;dashed=1;" edge="1" parent="1" source="vndbCelery" target="kana">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#6B7280;strokeWidth=1.5;endArrow=block;dashed=1;" edge="1" parent="1" source="imgCelery" target="tvndb">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e11" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#6B7280;strokeWidth=1.5;endArrow=block;dashed=1;exitX=1;exitY=0.5;" edge="1" parent="1" source="userserve" target="smtp">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e12" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#1D4ED8;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="vndbCelery" target="postgres">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e13" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#B91C1C;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="imgCelery" target="redis">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e14" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#7E22CE;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="imgCelery" target="disk">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e15" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#7E22CE;strokeWidth=2;endArrow=block;exitX=0;exitY=0.9;" edge="1" parent="1" source="caddy" target="disk">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="40" y="1064" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e15l" value="&lt;span style=&quot;font-size:11px;background:#fff;color:#7E22CE&quot;&gt;&lt;b&gt;file_server&lt;/b&gt; — image cache hit, Flask never runs&lt;/span&gt;" style="edgeLabel;html=1;align=center;" vertex="1" connectable="0" parent="e15">
          <mxGeometry x="0.55" relative="1" as="geometry" />
        </mxCell>

        <!-- ===================== legend ===================== -->
        <mxCell id="legend" value="&lt;b style=&quot;font-size:13px&quot;&gt;Reading the diagram&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Solid arrow = request path&amp;nbsp;&amp;nbsp;·&amp;nbsp;&amp;nbsp;Dashed arrow = asynchronous or outbound&lt;br&gt;&lt;b style=&quot;color:#BE185D&quot;&gt;Pink&lt;/b&gt; = the auth path; userserve answers the edge's probe on every gated request&lt;br&gt;&lt;b style=&quot;color:#A16207&quot;&gt;Amber box&lt;/b&gt; = a Celery worker process, separate from the web process&lt;br&gt;&lt;b&gt;Dashed grey box&lt;/b&gt; = not exposed at the edge&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9CA3AF;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="1240" width="760" height="118" as="geometry" />
        </mxCell>

        <mxCell id="procNote" value="&lt;b style=&quot;font-size:13px&quot;&gt;Process inventory (prod)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;&lt;code&gt;start-prod.ps1&lt;/code&gt; → Caddy + Next.js + &lt;code&gt;backend/launch.py prod&lt;/code&gt;.&lt;br&gt;launch.py starts: Redis, 2 Celery workers, 6 Waitress-served Flask apps.&lt;br&gt;PostgreSQL is a Windows service — checked for readiness, never spawned.&lt;br&gt;The dev stack swaps Waitress for the Flask dev server and adds Flower.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9CA3AF;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="860" y="1240" width="800" height="118" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
