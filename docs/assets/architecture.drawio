        <mxCell id="n69" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;exitX=0.305;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;strokeColor=#8A8A8A;dashed=1;strokeWidth=1.4;fontSize=10;fontColor=#8A8A8A;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="n24" target="n50"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="n70" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;exitX=0.305;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;strokeColor=#8A8A8A;dashed=1;strokeWidth=1.4;fontSize=10;fontColor=#8A8A8A;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="n27" target="n51"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="n71" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;exitX=0.305;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;strokeColor=#8A8A8A;dashed=1;strokeWidth=1.4;fontSize=10;fontColor=#8A8A8A;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="n29" target="n52"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="n72" value="forward_auth  /auth/verify" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;exitX=0.6848;exitY=1;exitDx=0;exitDy=0;entryX=0.9;entryY=0;entryDx=0;entryDy=0;strokeColor=#A73D38;dashed=1;strokeWidth=1.4;fontSize=10;fontColor=#A73D38;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="n20" target="n29"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="n73" value="&lt;b&gt;How to read this&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#4A4A4A&quot;&gt;No backend service imports another, and none calls another over HTTP — the only outbound traffic is the dashed Upstream row. Two runtime couplings exist instead:&lt;br&gt;&lt;br&gt;&lt;b&gt;forward_auth&lt;/b&gt; — Caddy asks userserve to authorise every gated route, so userserve being down gates four services shut although no code references it.&lt;br&gt;&lt;b&gt;the dashed green link&lt;/b&gt; — logserve reads and prunes the logs table vndbserve owns; only vndbserve migrates it, which is why logserve never calls create_all().&lt;br&gt;&lt;br&gt;errors.py is byte-identical in five services; config.py and logger.py are per-service copies — changing one means changing all.&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#DDDDDD;align=left;verticalAlign=top;spacingLeft=9;spacingTop=4;spacingRight=8;fontSize=13;fontColor=#1F2937;dashed=0;" vertex="1" parent="1"><mxGeometry x="60" y="1118" width="1050" height="168" as="geometry"/></mxCell>
        <mxCell id="n74" value="&lt;b&gt;Process tree — procserve.Supervisor&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#4A4A4A&quot;&gt;postgres — Windows service, never spawned, only waited for&lt;br&gt;redis&lt;br&gt;&amp;nbsp;&amp;nbsp;vndbserve_celery → vndbserve_flower&lt;br&gt;&amp;nbsp;&amp;nbsp;imgserve_celery → imgserve_flower&lt;br&gt;&amp;nbsp;&amp;nbsp;six Flask processes + Next.js&lt;br&gt;&lt;br&gt;Topological start, reverse-topological shutdown.&lt;br&gt;Ctrl+C is forwarded to every child.&lt;br&gt;&lt;br&gt;Redis is one server — the DB numbers are its logical databases.&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#DDDDDD;align=left;verticalAlign=top;spacingLeft=9;spacingTop=4;spacingRight=8;fontSize=13;fontColor=#1F2937;dashed=0;" vertex="1" parent="1"><mxGeometry x="1140" y="1118" width="760" height="168" as="geometry"/></mxCell>
        <mxCell id="n75" value="&lt;b&gt;&lt;font style=&quot;font-size:22px&quot;&gt;VisualNovelDatabase — backend architecture&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#6B7280&quot;&gt;one column per process · each store is one container holding only the databases it really has&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacingLeft=9;spacingTop=4;spacingRight=8;fontSize=13;fontColor=#1F2937;dashed=0;" vertex="1" parent="1"><mxGeometry x="60" y="24" width="1100" height="54" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
